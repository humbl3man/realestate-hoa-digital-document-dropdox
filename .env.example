# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TetherDocs

# Better Auth Configuration
# Generate a secret: openssl rand -hex 32 or any 32-char string
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration (SQLite local file, can be Turso libsql:// URL for hosting)
DATABASE_URL=file:sqlite.db
DATABASE_AUTH_TOKEN=

# Stripe Configuration
PLATFORM_FEE_PERCENTAGE=10
STRIPE_CLIENT_ID=
STRIPE_ACCOUNT_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Resend Configuration
RESEND_API_KEY=
EMAIL_FROM=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=digital-dropbox-documents

# File Upload Limits
NEXT_PUBLIC_MAX_UPLOAD_MB=5
NEXT_PUBLIC_MAX_DOCS_PER_PORTAL=10
